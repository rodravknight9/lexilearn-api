@page "/translator"
@using Lexilearn.Web.ViewModels
@using Lexilearn.Web.Services.Interfaces
@using Lexilearn.Web.Utils

@inject NavigationManager Navigation
@inject ITranslationService _translationService

<h2 class="text-primary">Lexilearn Translator</h2>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <EditForm Model="@_vm.Model" OnValidSubmit="OnSubmit">
                        <div class="mb-3 row">
                            <div class="col">
                                <label for="sourceLang" class="form-label">From</label>
                                <InputSelect 
                                id="sourceLang"
                                class="form-select"
                                @bind-Value="_vm.Model.LanguageSourceCode"
                                >
                                    @foreach (var language in _languages.Options)
                                    {
                                        <option value="@language.Key">@language.Value</option>

                                    }
                                </InputSelect>

                            </div>
                            <div class="col">
                                <label for="targetLang" class="form-label">To</label>
                                <InputSelect
                                id="sourceLang" 
                                class="form-select"
                                @bind-Value="_vm.Model.LanguageTargetCode"
                                >
                                    @foreach (var language in _languages.Options)
                                    {
                                        <option value="@language.Key">@language.Value</option>

                                    }
                                </InputSelect>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="sourceText" class="form-label">Input</label>
                            <InputTextArea 
                            id="sourceText" 
                            class="form-control" 
                            rows="3" 
                            placeholder="Type text here..."
                            @bind-Value="_vm.Model.Text">
                            </InputTextArea>
                        </div>

                        <div class="mb-3">
                            <label for="resultText" class="form-label">Translation</label>
                            <InputTextArea 
                            id="sourceText"
                            class="form-control"
                            rows="3"
                            placeholder="Type text here..."
                            @bind-Value="_vm.TranslationOutput.TranslatedText"
                            >
                            </InputTextArea>
                        </div>

                        <button type="submit" class="btn btn-primary">Translate</button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {

    private TranslationViewModel _vm = null!;
    private AvailableLanguages _languages = null!;

    protected override void OnInitialized()
    {
        _vm = new TranslationViewModel(_translationService);
        _languages = new AvailableLanguages();
    }

    private async Task OnSubmit()
    {
        await _vm.Send(_vm.Model);
    }
}
